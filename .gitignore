# ---- Root markdown / text: whitelist only ----
/*.md
/*.txt
!/README.md
!/README.*.md
!/GLOSSARY.md
!/GLOSSARY-MAP.md

# ---- Local-only (never published) ----
/notes/
/_archive/
/.claude/
/.agents/
/skills-lock.json

# ---- Code index (local) ----
/.codegraph/

# ---- Credentials ----
.credentials.json
acc_*.json
*.pem
*.key
.env
.env.*
!.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# ---- OS / editor ----
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
